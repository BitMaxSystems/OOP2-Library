<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="860.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.bitmaxsystems.oop2library.controllers.ReaderMainController">

    <Button layoutX="14.0" layoutY="14.0" text="Logout" onAction="#onLogout"/>
    <Button fx:id="userDetailsButton" layoutX="100.0" layoutY="14.0" prefWidth="180.0"
            text="User" onAction="#onUserDetails"/>
    <Label fx:id="loyaltyPointsLabel" layoutX="300.0" layoutY="14.0" prefWidth="200.0">
        <font><Font size="13.0"/></font>
    </Label>

    <Label layoutX="14.0" layoutY="55.0" text="Search:">
        <font><Font size="13.0"/></font>
    </Label>
    <TextField fx:id="searchField" layoutX="75.0" layoutY="52.0" prefWidth="300.0"/>

    <TableView fx:id="bookTableView" layoutX="14.0" layoutY="85.0" prefHeight="200.0" prefWidth="830.0">
        <columns>
            <TableColumn fx:id="titleColumn" prefWidth="220.0" text="Title"/>
            <TableColumn fx:id="authorColumn" prefWidth="160.0" text="Author"/>
            <TableColumn fx:id="genreColumn" prefWidth="120.0" text="Genre"/>
            <TableColumn fx:id="publisherColumn" prefWidth="160.0" text="Publisher"/>
            <TableColumn fx:id="availabilityColumn" prefWidth="110.0" text="Availability"/>
        </columns>
    </TableView>

    <Button layoutX="14.0" layoutY="295.0" prefWidth="120.0" text="Reserve" onAction="#onReserve">
        <font><Font size="13.0"/></font>
    </Button>

    <Label layoutX="14.0" layoutY="330.0" text="My Loans:">
        <font><Font size="14.0"/></font>
    </Label>
    <TableView fx:id="loanTableView" layoutX="14.0" layoutY="355.0" prefHeight="130.0" prefWidth="830.0">
        <columns>
            <TableColumn fx:id="loanBookColumn" prefWidth="250.0" text="Book"/>
            <TableColumn fx:id="loanBorrowedDateColumn" prefWidth="170.0" text="Borrowed Date"/>
            <TableColumn fx:id="loanDueDateColumn" prefWidth="170.0" text="Due Date"/>
            <TableColumn fx:id="loanStatusColumn" prefWidth="200.0" text="Status"/>
        </columns>
    </TableView>

    <Label layoutX="500.0" layoutY="330.0" text="My Reservations:">
        <font><Font size="14.0"/></font>
    </Label>
    <TableView fx:id="reservationTableView" layoutX="500.0" layoutY="355.0" prefHeight="130.0" prefWidth="344.0">
        <columns>
            <TableColumn fx:id="reservationBookColumn" prefWidth="150.0" text="Book"/>
            <TableColumn fx:id="reservationDateColumn" prefWidth="100.0" text="Reserved On"/>
            <TableColumn fx:id="reservationStatusColumn" prefWidth="90.0" text="Status"/>
        </columns>
    </TableView>

    <Button layoutX="500.0" layoutY="295.0" prefWidth="160.0" text="Cancel Reservation"
            onAction="#onCancelReservation">
        <font><Font size="13.0"/></font>
    </Button>

</AnchorPane>