<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="260.0"
            prefWidth="430.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.bitmaxsystems.oop2library.controllers.InventoryCopyCreationController">

    <Label layoutX="35.0"
           layoutY="40.0"
           text="Book:" />

    <ComboBox fx:id="bookComboBox"
              layoutX="120.0"
              layoutY="35.0"
              prefWidth="260.0" />

    <Label layoutX="35.0"
           layoutY="100.0"
           text="Quantity:" />

    <Spinner fx:id="quantitySpinner"
             layoutX="120.0"
             layoutY="95.0"
             prefWidth="100.0" />

    <Button layoutX="110.0"
            layoutY="180.0"
            text="Cancel"
            onAction="#onCancel" />

    <Button layoutX="240.0"
            layoutY="180.0"
            text="Add copies"
            onAction="#onCreate" />

</AnchorPane>