<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="493.0"
            prefWidth="914.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.bitmaxsystems.oop2library.controllers.AdministrativeInventoryController">
   <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" prefHeight="31.0" prefWidth="91.0" text="Back" onAction="#onBackToMainDialog">
      <font>
         <Font size="15.0"/>
      </font>
   </Button>
   <TableView fx:id="tableView"
              layoutX="34.0"
              layoutY="70.0"
              prefHeight="200.0"
              prefWidth="847.0">
      <columns>
         <TableColumn fx:id="inventoryIdColumn"
                      prefWidth="88.0"
                      text="Inventory ID"/>

         <TableColumn fx:id="statusColumn"
                      prefWidth="105.0"
                      text="Book Status"/>

         <TableColumn fx:id="archivedColumn"
                      prefWidth="80.0"
                      text="Archived" />

         <TableColumn fx:id="isbnColumn"
                      prefWidth="123.0"
                      text="ISBN"/>

         <TableColumn fx:id="titleColumn"
                      prefWidth="178.0"
                      text="Name"/>

         <TableColumn fx:id="authorColumn"
                      prefWidth="137.0"
                      text="Author"/>

         <TableColumn fx:id="genreColumn"
                      prefWidth="109.0"
                      text="Genre"/>

         <TableColumn fx:id="publisherColumn"
                      prefWidth="106.0"
                      text="Publisher"/>

         <TableColumn fx:id="archiveColumn"
                      prefWidth="90.0"
                      text="Archive"/>

         <TableColumn fx:id="deleteColumn"
                      prefWidth="90.0"
                      text="Delete"/>
      </columns>
   </TableView>
   <Button alignment="CENTER" layoutX="190.0" layoutY="332.0" mnemonicParsing="false" prefHeight="84.0"
           prefWidth="125.0" text="Add book copy to Inventory" textAlignment="CENTER" wrapText="true" onAction="#onAddCopies">
      <font>
         <Font size="15.0"/>
      </font>
   </Button>
   <Button alignment="CENTER" layoutX="563.0" layoutY="332.0" mnemonicParsing="false" prefHeight="84.0"
           prefWidth="125.0" text="View registered books" textAlignment="CENTER" wrapText="true" onAction="#onViewRegisteredBooks">
      <font>
         <Font size="15.0"/>
      </font>
   </Button>
</AnchorPane>
