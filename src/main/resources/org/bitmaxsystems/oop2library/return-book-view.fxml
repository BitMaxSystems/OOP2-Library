<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.bitmaxsystems.oop2library.controllers.ReturnBookController">

    <Label alignment="CENTER" layoutX="191.0" layoutY="26.0" prefHeight="35.0" prefWidth="221.0" text="Return Book">
        <font><Font size="27.0"/></font>
    </Label>

    <Label layoutX="61.0" layoutY="100.0" text="Reader:">
        <font><Font size="15.0"/></font>
    </Label>
    <ComboBox fx:id="userComboBox" layoutX="191.0" layoutY="97.0" prefWidth="320.0"/>

    <Label layoutX="61.0" layoutY="155.0" text="Loan:">
        <font><Font size="15.0"/></font>
    </Label>
    <ComboBox fx:id="loanComboBox" layoutX="191.0" layoutY="152.0" prefWidth="320.0"/>

    <Label layoutX="61.0" layoutY="210.0" text="Borrowed:">
        <font><Font size="15.0"/></font>
    </Label>
    <Label fx:id="borrowedDateLabel" layoutX="191.0" layoutY="210.0" prefWidth="320.0">
        <font><Font size="13.0"/></font>
    </Label>

    <Label layoutX="61.0" layoutY="245.0" text="Due Date:">
        <font><Font size="15.0"/></font>
    </Label>
    <Label fx:id="dueDateLabel" layoutX="191.0" layoutY="245.0" prefWidth="320.0">
        <font><Font size="13.0"/></font>
    </Label>

    <CheckBox fx:id="damagedCheckBox" layoutX="191.0" layoutY="290.0" text="Mark copy as damaged">
        <font><Font size="13.0"/></font>
    </CheckBox>

    <Label fx:id="statusLabel" layoutX="61.0" layoutY="325.0" prefWidth="480.0" textFill="RED">
        <font><Font size="13.0"/></font>
    </Label>

    <Button layoutX="191.0" layoutY="370.0" prefWidth="100.0" text="Return" onAction="#onReturn">
        <font><Font size="15.0"/></font>
    </Button>
    <Button layoutX="311.0" layoutY="370.0" prefWidth="100.0" text="Close" onAction="#onClose">
        <font><Font size="15.0"/></font>
    </Button>

</AnchorPane>