<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.bitmaxsystems.oop2library.controllers.LoanManagementController">

    <TableView fx:id="tableView" layoutX="12.0" layoutY="12.0" prefHeight="340.0" prefWidth="976.0">
        <columns>
            <TableColumn fx:id="userColumn" prefWidth="150.0" text="Reader"/>
            <TableColumn fx:id="bookColumn" prefWidth="200.0" text="Book"/>
            <TableColumn fx:id="copyColumn" prefWidth="80.0" text="Copy #"/>
            <TableColumn fx:id="borrowedDateColumn" prefWidth="160.0" text="Borrowed Date"/>
            <TableColumn fx:id="dueDateColumn" prefWidth="160.0" text="Due Date"/>
            <TableColumn fx:id="returnedDateColumn" prefWidth="160.0" text="Returned Date"/>
            <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status"/>
        </columns>
    </TableView>

    <RadioButton fx:id="allRadio" layoutX="50.0" layoutY="370.0" text="All">
        <font><Font size="14.0"/></font>
    </RadioButton>
    <RadioButton fx:id="activeRadio" layoutX="120.0" layoutY="370.0" text="Active">
        <font><Font size="14.0"/></font>
    </RadioButton>
    <RadioButton fx:id="overdueRadio" layoutX="200.0" layoutY="370.0" text="Overdue">
        <font><Font size="14.0"/></font>
    </RadioButton>

    <Label fx:id="overdueCountLabel" layoutX="350.0" layoutY="370.0" prefWidth="300.0">
        <font><Font size="14.0"/></font>
    </Label>

    <Button layoutX="50.0" layoutY="440.0" prefWidth="140.0" text="Borrow Book" onAction="#onBorrowBook">
        <font><Font size="14.0"/></font>
    </Button>
    <Button layoutX="210.0" layoutY="440.0" prefWidth="140.0" text="Return Book" onAction="#onReturnBook">
        <font><Font size="14.0"/></font>
    </Button>

</AnchorPane>