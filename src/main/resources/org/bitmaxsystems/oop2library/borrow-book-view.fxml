<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.bitmaxsystems.oop2library.controllers.BorrowBookController">

    <Label alignment="CENTER" layoutX="191.0" layoutY="26.0" prefHeight="35.0" prefWidth="221.0" text="Borrow Book">
        <font><Font size="27.0"/></font>
    </Label>

    <Label layoutX="61.0" layoutY="100.0" text="Reader:">
        <font><Font size="15.0"/></font>
    </Label>
    <ComboBox fx:id="userComboBox" layoutX="191.0" layoutY="97.0" prefWidth="320.0"/>

    <Label layoutX="61.0" layoutY="155.0" text="Book:">
        <font><Font size="15.0"/></font>
    </Label>
    <ComboBox fx:id="bookComboBox" layoutX="191.0" layoutY="152.0" prefWidth="320.0"/>

    <Label layoutX="61.0" layoutY="210.0" text="Copy:">
        <font><Font size="15.0"/></font>
    </Label>
    <ComboBox fx:id="inventoryComboBox" layoutX="191.0" layoutY="207.0" prefWidth="320.0"/>

    <Label layoutX="61.0" layoutY="265.0" text="Due Date:">
        <font><Font size="15.0"/></font>
    </Label>
    <DatePicker fx:id="dueDatePicker" layoutX="191.0" layoutY="262.0" prefWidth="320.0"/>

    <Label fx:id="statusLabel" layoutX="61.0" layoutY="320.0" prefWidth="480.0" textFill="RED">
        <font><Font size="13.0"/></font>
    </Label>

    <Button layoutX="191.0" layoutY="370.0" prefWidth="100.0" text="Borrow" onAction="#onBorrow">
        <font><Font size="15.0"/></font>
    </Button>
    <Button layoutX="311.0" layoutY="370.0" prefWidth="100.0" text="Close" onAction="#onClose">
        <font><Font size="15.0"/></font>
    </Button>

</AnchorPane>